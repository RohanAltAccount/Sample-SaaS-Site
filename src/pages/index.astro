---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Templately is a free SaaS landing page template made for any digital company, with polished placeholder sections and filler copy ready to customize."
    />
    <title>Templately | Free SaaS landing page template</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-reveal>
      <a class="brand" href="#" aria-label="Templately home">
        <span class="brand-mark" aria-hidden="true">T</span>
        <span>Templately</span>
      </a>

      <nav class="site-nav" aria-label="Main navigation">
        <button class="nav-link pressable" type="button">Product</button>
        <button class="nav-link pressable" type="button">Solutions</button>
        <button class="nav-link pressable" type="button">Resources</button>
        <button class="nav-link pressable" type="button">Company</button>
      </nav>

      <div class="header-actions">
        <button class="ghost-button pressable" type="button">Log in</button>
        <button class="primary-button pressable" type="button">Get started</button>
      </div>
    </header>

    <main id="main-content">
      <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Free SaaS landing page template</p>
          <h1 id="hero-title">A sharper foundation for your next digital company.</h1>
          <p class="hero-lede">
            Templately is a free SaaS template created by me, Rohan Modi (@RohanAltAccount). It gives any
            digital company a composed landing page foundation with responsive
            layouts, reusable sections, and easy-to-replace copy.
          </p>

          <div class="hero-actions" aria-label="Primary actions">
            <button class="primary-button large pressable" type="button">
              Get started
            </button>
            <button class="secondary-button large pressable" type="button">
              View sections
            </button>
          </div>
        </div>

        <figure class="hero-dashboard" data-reveal style="--delay: 80ms">
          <div class="image-meta" aria-hidden="true">
            <span>Template preview</span>
            <span>01 / 05</span>
          </div>
          <img
            src="/linear.png"
            alt="Templately template dashboard preview with SaaS-style metric cards and project rows."
            loading="eager"
          />
        </figure>

        <dl class="hero-stats" aria-label="Templately template highlights" data-reveal style="--delay: 120ms">
          <div>
            <dt>Free</dt>
            <dd>Template starter</dd>
          </div>
          <div>
            <dt>100%</dt>
            <dd>Responsive layout</dd>
          </div>
          <div>
            <dt>Any</dt>
            <dd>Digital company</dd>
          </div>
        </dl>
      </section>

      <section class="logo-strip" aria-label="Example company row">
        <div class="section-inner logo-row" data-reveal>
          <span class="strip-label">Built to adapt</span>
          <span>Placeholder</span>
          <span>Startup Co.</span>
          <span>Digital Lab</span>
          <span>Cloud Studio</span>
          <span>Acme SaaS</span>
        </div>
      </section>

      <section class="section feature-section" aria-labelledby="features-title">
        <div class="section-inner">
          <div class="section-heading" data-reveal>
            <p class="eyebrow">Template system</p>
            <h2 id="features-title">A familiar SaaS story, stripped back to what matters.</h2>
            <p>
              Use this layout as a starting point for a software product, agency
              tool, AI platform, analytics app, or any digital company that needs
              a polished page without visual noise.
            </p>
          </div>

          <div class="feature-grid" aria-label="Included template sections">
            <article class="feature-card" data-reveal style="--delay: 40ms">
              <span class="feature-index">01</span>
              <div>
                <h3>Hero section</h3>
                <p>
                  A strong above-the-fold area with a clear headline, concise
                  description, focused actions, proof metrics, and a product visual.
                </p>
              </div>
            </article>

            <article class="feature-card" data-reveal style="--delay: 90ms">
              <span class="feature-index">02</span>
              <div>
                <h3>Reusable content</h3>
                <p>
                  Replace the filler copy with benefits, outcomes, use cases, and
                  proof points without rebuilding the underlying structure.
                </p>
              </div>
            </article>

            <article class="feature-card" data-reveal style="--delay: 140ms">
              <span class="feature-index">03</span>
              <div>
                <h3>Responsive layout</h3>
                <p>
                  The page adapts from broad desktop compositions to focused mobile
                  reading with stable spacing and readable type.
                </p>
              </div>
            </article>

            <article class="feature-card" data-reveal style="--delay: 190ms">
              <span class="feature-index">04</span>
              <div>
                <h3>Launch-ready structure</h3>
                <p>
                  Swap in your logo, product screenshots, real evidence, and live
                  calls to action when you are ready to ship.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section flow-band" aria-labelledby="flow-title">
        <div class="section-inner flow-layout">
          <div class="section-heading compact" data-reveal>
            <p class="eyebrow">Page flow</p>
            <h2 id="flow-title">Move from promise to proof without losing the reader.</h2>
            <p>
              The page guides visitors from a clear product statement into benefits,
              proof, and a simple next action. Each section has one job.
            </p>
          </div>

          <div class="flow-list" aria-label="Workflow stages">
            <article class="flow-item" data-reveal style="--delay: 60ms">
              <span>01</span>
              <h3>Introduce the product</h3>
              <p>Use direct copy to establish the value proposition and audience.</p>
            </article>
            <article class="flow-item" data-reveal style="--delay: 120ms">
              <span>02</span>
              <h3>Show the evidence</h3>
              <p>Add real benefits, product context, outcomes, and supporting proof.</p>
            </article>
            <article class="flow-item" data-reveal style="--delay: 180ms">
              <span>03</span>
              <h3>Invite the next step</h3>
              <p>Keep the call to action clear, singular, and easy to understand.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section metrics-section" aria-labelledby="metrics-title">
        <div class="section-inner metrics-layout">
          <div class="metric-panel" data-reveal>
            <p class="eyebrow">Template readiness</p>
            <div class="metric-head">
              <strong>86%</strong>
              <span>ready to customize</span>
            </div>
            <div class="progress-track" aria-hidden="true">
              <span class="progress-fill"></span>
            </div>
            <ul>
              <li><span>01</span> Hero copy placeholder added</li>
              <li><span>02</span> SaaS-style sections included</li>
              <li><span>03</span> Buttons use demo interactions only</li>
            </ul>
          </div>

          <div class="section-heading compact" data-reveal style="--delay: 100ms">
            <p class="eyebrow">Made by Rohan Modi (@RohanAltAccount)</p>
            <h2 id="metrics-title">A free template built to become your own.</h2>
            <p>
              Templately is intentionally generic so founders, designers, and
              builders can adapt it quickly. Add your identity, product screenshots,
              real proof points, and launch-ready copy.
            </p>
          </div>
        </div>
      </section>

      <section class="section pricing-section" aria-labelledby="pricing-title">
        <div class="section-inner">
          <div class="section-heading pricing-heading" data-reveal>
            <p class="eyebrow">Pricing filler</p>
            <h2 id="pricing-title">Simple pricing, presented without distraction.</h2>
            <p>Use these as structural placeholders, then replace them with your real offer.</p>
          </div>

          <div class="pricing-grid">
            <article class="price-card" data-reveal style="--delay: 60ms">
              <p class="plan-name">Studio</p>
              <p class="price">$19<span>/seat</span></p>
              <p>Placeholder plan copy for startups, creators, and lean teams.</p>
              <button class="secondary-button pressable" type="button">Choose Studio</button>
            </article>
            <article class="price-card featured" data-reveal style="--delay: 120ms">
              <div class="plan-topline">
                <p class="plan-name">Scale</p>
                <span>Recommended</span>
              </div>
              <p class="price">$49<span>/seat</span></p>
              <p>Filler text for growing teams that want a classic SaaS tier.</p>
              <button class="primary-button pressable" type="button">Choose Scale</button>
            </article>
            <article class="price-card" data-reveal style="--delay: 180ms">
              <p class="plan-name">Enterprise</p>
              <p class="price">Custom</p>
              <p>Generic enterprise copy for larger companies and custom needs.</p>
              <button class="secondary-button pressable" type="button">Contact sales</button>
            </article>
          </div>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="cta-title">
        <div class="section-inner final-cta-grid" data-reveal>
          <p class="eyebrow">Templately</p>
          <h2 id="cta-title">Use this free SaaS template for your next digital company.</h2>
          <div>
            <p>
              Replace the placeholders with real evidence and make the system yours.
            </p>
            <button class="inverse-button large pressable" type="button">
              Get started
            </button>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <span class="brand-mark inverse" aria-hidden="true">T</span>
        <span>Templately</span>
      </div>
      <span>A free SaaS landing page template created by Rohan Modi (@RohanAltAccount).</span>
      <span>Built for clear products and real proof.</span>
    </footer>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
